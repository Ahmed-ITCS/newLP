# Comma-separated list of browser origins allowed to POST to /api/contact.
ALLOWED_ORIGINS=https://pentacipher.com,https://www.pentacipher.com

# GoHighLevel Private Integration token. Server-side only, never expose to the browser.
GHL_API_TOKEN=
GHL_LOCATION_ID=
# Where new-lead notification emails should be sent.
GHL_NOTIFY_EMAIL=

# Optional fallback: GoHighLevel inbound webhook URL.
GHL_WEBHOOK_URL=
